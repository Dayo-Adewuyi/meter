{
  "name": "@meter/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/bootstrap/api.js",
    "dev:worker": "tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/bootstrap/worker.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/api.js",
    "start:worker": "node dist/bootstrap/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:financial": "vitest run --config vitest.financial.config.ts",
    "demo:timeline": "node --env-file-if-exists=../../.env src/scripts/demo-timeline.ts",
    "demo:concurrency": "node --env-file-if-exists=../../.env src/scripts/demo-concurrency.ts",
    "demo:setup": "node --env-file-if-exists=../../.env dist/scripts/demo-setup.js"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@meter/config": "workspace:*",
    "@meter/contracts": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@meter/testing": "workspace:*",
    "@nestjs/testing": "12.0.1",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.0",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
