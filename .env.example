# Local development. Copy to .env — never commit real credentials.
NODE_ENV=development
DATABASE_URL=postgres://meter:meter@localhost:5432/meter
PORT=3001

# Clerk (auth). Meter owns authorization; Clerk owns authentication.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Providers — leave blank locally to use mocks.
AI_PRIMARY_API_KEY=
PAYMENT_PARTNER_API_KEY=
PAYMENT_PARTNER_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

SENTRY_DSN=
LOG_LEVEL=debug
