# Local development. Copy to .env — never commit real credentials.
NODE_ENV=development
DATABASE_URL=postgres://meter:meter@localhost:5432/meter
PORT=3001

# Clerk (auth). Meter owns authorization; Clerk owns authentication.
# CLERK_JWT_KEY is optional: set it to verify tokens without a JWKS fetch.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Providers — leave blank locally to use mocks.
AI_PRIMARY_API_KEY=
PAYMENT_PARTNER_API_KEY=
PAYMENT_PARTNER_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

SENTRY_DSN=
LOG_LEVEL=debug

# Agent mandates (sandbox only). Pepper: 32+ random chars, e.g. `openssl rand -base64 48`.
METER_AGENTS_SANDBOX=true
METER_CREDENTIAL_PEPPER=

# Owner web app (apps/web). Without a Clerk publishable key it runs on demo data.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_METER_API_URL=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_METER_DEMO=false
