# One registry. No mirrors, no per-scope overrides, no git or tarball dependencies.
registry=https://registry.npmjs.org/

# Exact versions only: manifests never drift from the reviewed lockfile.
save-exact=true
save-workspace-protocol=rolling

# Lifecycle scripts are off for npm/npx too, not only pnpm.
ignore-scripts=true

# CI installs must fail rather than silently rewrite the lockfile.
prefer-frozen-lockfile=true
